# RD Insights — variaveis de ambiente
# Copie para .env (raiz) e/ou apps/api/.env; nunca commitar com valores reais.

# --- App ---
NODE_ENV=development
PORT=22501
CORS_ORIGIN=http://localhost:22500
APP_URL=http://localhost:22500

# --- Banco / Redis ---
DATABASE_URL=postgresql://rd:rd@localhost:22506/rd
REDIS_URL=redis://localhost:22509
RD_RATE_LIMIT_PER_MIN=60

# --- Seguranca ---
JWT_ACCESS_SECRET=troque-por-32-chars-aleatorios-openssl-rand
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# openssl rand -base64 32  (obrigatoria em producao)
SECRETS_KEY=

# --- RD Station ---
# Base da API do RD (so muda em teste)
RD_API_BASE_URL=https://api.rd.services
# Fallback global de credenciais: o painel (RdConnection por conta) tem prioridade;
# se a conta nao tiver client_id/client_secret cadastrados, cai nestas duas envs.
# URL de callback a cadastrar no app RD: <APP_URL>/api/rd/callback
RD_CLIENT_ID=
RD_CLIENT_SECRET=
# Reconciliacao de memberships e conversoes recentes; nao atualiza todos os campos.
RD_RECONCILIATION_ENABLED=true
RD_RECONCILIATION_INTERVAL_MINUTES=60
RD_REFRESH_ENABLED=true

# --- Producao ---
TRUST_PROXY=
REGISTRATION_OPEN=false
SUPER_ADMIN_EMAIL=
WEB_DIST_DIR=

# --- E-mail de recuperação ---
# SMTP é opcional em dev/test; link e token são redigidos nos logs.
# Em produção, sem SMTP, redefinições ficam indisponíveis e isso aparece no log do serviço.
SMTP_HOST=
# Padrões ao informar SMTP_HOST: porta 587, STARTTLS obrigatório.
# Para um mail catcher local sem TLS, defina SMTP_REQUIRE_TLS=false.
SMTP_PORT=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
